.shop-root
{
    flex-grow:1;
    align-items:center;
    justify-content: center;
}

.shop-view
{
    width: 90%;
    height: 60%;

    background-color: rgba(223, 246, 245, 0.8);
    color: rgb(67, 74, 95);

    padding:0;
    margin:0;
}

.shop-header
{
    height:20%;
    padding: 35px 25px 0 25px;

    flex-direction:row;
    justify-content:space-between;
}

.coins-label
{
    font-size:40px;
    -unity-font-style: bold;
}

.close-button
{
    width:130px;
    height:80px;

    background-color: rgb(223, 246, 245);
    border-color: rgb(67, 74, 95);
    border-width: 5px;

    color: rgb(67, 74, 95);
    font-size:30px;
    -unity-font-style: bold;
}

.skin-scroll
{
    flex-grow:1;
}

.skin-grid
{
    flex-direction:row;
    flex-wrap:wrap;
}