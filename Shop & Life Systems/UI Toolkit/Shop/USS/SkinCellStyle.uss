.skin-cell
{
    width: 250px;
    height: 280px;
    margin: 20px;
    position: relative;
    align-items: center; 
}

.skin-icon
{
    width: 180px;
    height: 180px;
}

.button-box
{
    justify-content: center;
    align-items: center;

    font-size: 30px;

    width: 100%;
    height: 100px;
}

.skin-button
{
    width: 150px;
    height: 50px;

    background-color: rgb(223, 246, 245);
    border-color: rgb(67, 74, 95);
    border-width: 5px;

    color: rgb(67, 74, 95);
    font-size:30px;
    -unity-font-style: bold;
}

.label-box
{
    position: absolute; 
    top: 0;
    left: 35px;         

    width: 180px;
    height: 180px;
    
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.cost-label
{
    color: white;
    font-size: 50px;
    -unity-font-style: bold;

    margin: 0;
    padding: 0;
}
